# Server (local dev; ignored on Vercel)
PORT=4111
LOG_LEVEL=info

# AI (Gemini via Mastra model router)
GEMINI_API_KEY=your_gemini_api_key
AI_TEMPERATURE=0.1
AI_TIMEOUT=60000
EXTRACTION_CHUNK_SIZE=200

# File storage (S3 bucket the website uploads import files to)
FILE_SERVICE_PROVIDER=s3
FILE_SERVICE_REGION=eu-west-3
FILE_SERVICE_ACCESS_KEY_ID=your_access_key
FILE_SERVICE_SECRET_ACCESS_KEY=your_secret_key
FILE_SERVICE_BUCKET_NAME=my-expenses-private

# Request state store (Upstash Redis REST)
REDIS_URL=https://your-upstash-instance.upstash.io
REDIS_TOKEN=your_upstash_token
